{
  "name": "@vellum/shared",
  "version": "0.6.0",
  "private": true,
  "description": "Shared schema, types, locales, and validators between Vellum apps",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./locales/*.json": "./src/locales/*.json",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "tldraw": "4.5.10",
    "zod": "^4.3.6"
  }
}
