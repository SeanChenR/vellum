{
  "name": "vellum",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Canvas-based collaborative web app built on tldraw SDK",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter '*' dev",
    "dev:up": "bun scripts/dev.ts",
    "dev:down": "brew services stop postgresql@14 mailpit; lsof -ti:3000,3002 | xargs -r kill",
    "build": "bun --filter '*' build",
    "start": "bun --filter '@vellum/api' start",
    "test": "bun test apps packages",
    "test:watch": "bun test apps packages --watch",
    "test:coverage": "bun test apps packages --coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test smoke.spec.ts auth-magic-link.spec.ts canvas-crud.spec.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxlint --fix",
    "typecheck": "bun --filter '*' typecheck",
    "db:generate": "cd apps/api && bunx drizzle-kit generate",
    "db:migrate": "cd apps/api && bunx drizzle-kit migrate",
    "db:studio": "cd apps/api && bunx drizzle-kit studio",
    "mailpit:up": "docker compose up -d mailpit",
    "mailpit:down": "docker compose down mailpit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.9.0",
    "@playwright/test": "^1.59.1",
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "oxlint": "^0.15.0",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md}": [
      "oxlint --fix"
    ]
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
