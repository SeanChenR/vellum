# Dependencies
node_modules/
.pnp/
.pnp.js

# Build outputs
dist/
build/
out/
.next/
.turbo/
.parcel-cache/
*.tsbuildinfo

# Bun
.bun/

# Tailwind generated CSS (compiled output, regenerated on build)
*.gen.css

# Test / coverage
coverage/
.nyc_output/
playwright-report/
test-results/
playwright/.cache/
.playwright-mcp/

# Visual review artifacts (Playwright runs, large + ephemeral).
# Folder structure stays via .gitkeep + README; the PNGs themselves are local-only.
docs/screenshots/**/*.png
docs/screenshots/**/*.jpg
!docs/screenshots/**/.gitkeep
!docs/screenshots/README.md

# Drizzle
drizzle/meta/

# Environment
.env
.env.local
.env.*.local

# IDE / editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
bun-debug.log*

# Claude Code local settings (user-specific overrides)
.claude/settings.local.json
.spectra/
openspec/.vector-search.db*
