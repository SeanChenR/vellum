{
  "name": "@vellum/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Vellum frontend — React + tldraw SDK + Tailwind v4",
  "scripts": {
    "dev": "concurrently --names tw,web --prefix-colors cyan,green \"bun run tailwind:watch\" \"PORT=3001 bun --hot src/index.html\"",
    "build": "bun run tailwind:build && bun build src/index.html --outdir=dist --minify",
    "tailwind:build": "tailwindcss -i ./src/styles.css -o ./src/styles.gen.css --minify",
    "tailwind:watch": "tailwindcss -i ./src/styles.css -o ./src/styles.gen.css --watch",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "tldraw": "4.5.10",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.100.6",
    "@tanstack/react-query-devtools": "^5.100.6",
    "@tanstack/react-router": "^1.168.25",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@vellum/shared": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.0.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "motion": "^12.38.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.74.0",
    "react-i18next": "^17.0.6",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.9.0",
    "@tailwindcss/cli": "^4.2.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.2.4"
  }
}
