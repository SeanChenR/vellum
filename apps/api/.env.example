# Copy to apps/api/.env and fill in real values.
# .env is gitignored; never commit secrets.

# Server
PORT=3000
LOG_LEVEL=debug
NODE_ENV=development

# Postgres (Neon — get connection string from console.neon.tech)
DATABASE_URL=postgresql://user:password@host:5432/vellum

# better-auth (will be filled in M1 auth spec)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (M1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mailpit SMTP (dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@vellum.local
