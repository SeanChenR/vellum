# Copy to apps/api/.env and fill in real values.
# .env is gitignored; never commit secrets.

# Server
PORT=3000
LOG_LEVEL=debug
NODE_ENV=development

# Postgres (Neon — get connection string from console.neon.tech)
DATABASE_URL=postgresql://user:password@host:5432/vellum

# better-auth (generate with: openssl rand -hex 32)
BETTER_AUTH_SECRET=change-me-32-bytes-hex
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Get from https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mailpit SMTP (dev — docker compose up -d mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@vellum.local

# BYOK encryption key (Phase 2, M11.1)
# Master key for AES-256-GCM encryption of provider API keys stored in
# the api_keys table. MUST be exactly 64 hex chars (32 bytes).
# Generate with: bun -e "console.log(crypto.randomBytes(32).toString('hex'))"
# Server fails to start if this is missing or wrong length.
API_KEY_ENCRYPTION_KEY=change-me-64-hex-chars-aes256-gcm-master-key-replace-this-XX

# Optional: override Anthropic vendor base URL (used by integration tests
# to point at a stub server). Defaults to https://api.anthropic.com.
ANTHROPIC_API_BASE_URL=https://api.anthropic.com

