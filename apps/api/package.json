{
  "name": "@vellum/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Vellum backend — Bun.serve handling HTTP, WebSocket, and static frontend",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --outdir=dist --target=bun",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vellum/shared": "workspace:*"
  }
}
