{
  "name": "@vellum/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Vellum backend — Bun.serve handling HTTP, WebSocket, and static frontend",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --outdir=dist --target=bun",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vellum/shared": "workspace:*",
    "better-auth": "^1.6.9",
    "drizzle-orm": "^0.45.2",
    "ipaddr.js": "^2.3.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3"
  }
}
